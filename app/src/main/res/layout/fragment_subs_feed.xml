<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
			 android:layout_width="match_parent"
			 android:layout_height="match_parent">

	<include
		android:id="@+id/videos_gridview"
		layout="@layout/videos_gridview"
		android:layout_width="match_parent"
		android:layout_height="match_parent"/>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:id="@+id/noSubscriptionsText"
		android:visibility="gone"
		android:background="@color/grid_view_background">
		<TextView
			android:text="@string/no_subscriptions_text"
			style="@style/NoItemFoundMsgTextView"/>

		<Button
			android:id="@+id/importSubscriptionsButton"
			android:text="@string/import_subscriptions_from_youtube"
			style="@style/ImportSubscriptionsButton"/>

		<Button
			android:id="@+id/importBackupButton"
			android:text="@string/pref_title_import_dbs"
			style="@style/ImportSubscriptionsButton"/>
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:id="@+id/noFilteredVideosText"
		android:visibility="gone"
		android:background="@color/grid_view_background">
		<TextView
			android:text="@string/filter_no_matches"
			style="@style/NoItemFoundMsgTextView"/>

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="20dp"
			android:orientation="horizontal">

			<Button
				android:id="@+id/resetFiltersButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/filter_reset_filters" />

			<Button
				android:id="@+id/showFiltersButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="8dp"
				android:text="@string/filter_show_filters" />

		</LinearLayout>

	</LinearLayout>

</FrameLayout>